# =====================================================================
# FARMYUGA — environment variables
# ---------------------------------------------------------------------
# Copy to .env.local for local development:   cp .env.example .env.local
#
# On cPanel do NOT upload a .env file. Set these in:
#   cPanel → Setup Node.js App → your app → Environment variables
# then click RESTART. Values set there are injected into process.env.
#
# .env* is git-ignored — never commit real credentials.
# =====================================================================


# ---------------------------------------------------------------------
# EMAIL (required for inquiries to reach your inbox)
# ---------------------------------------------------------------------
# Create the mailbox first: cPanel → Email Accounts → Create
# (e.g. hello@farmyuga.com), then use its details below.
# cPanel shows the exact host under "Connect Devices" → Mail Client Manual
# Settings. It is usually mail.yourdomain.com.

SMTP_HOST=mail.farmyuga.com
SMTP_PORT=465
SMTP_USER=hello@farmyuga.com
SMTP_PASS=the-mailbox-password

# Where leads are delivered. Defaults to siteConfig.email if unset.
LEAD_TO_EMAIL=hello@farmyuga.com


# ---------------------------------------------------------------------
# WHATSAPP ALERT (optional — the form works without it)
# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API. Set up at developers.facebook.com:
#   1. Create a Business app, add the "WhatsApp" product
#   2. Register your sender number → gives you a Phone number ID
#   3. Generate a PERMANENT access token (System User token). The temporary
#      one in the dashboard expires after 24 hours.
#
# WHATSAPP_ALERT_TO is the number that receives the alert — your own
# dispatch phone. Digits only, with country code, no "+".

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=917209909097

# Meta only allows free-form WhatsApp text inside a 24-hour reply window, so a
# business-initiated alert needs an APPROVED MESSAGE TEMPLATE with exactly one
# body variable, e.g.:
#
#     New website inquiry:
#     {{1}}
#
# Create it under WhatsApp Manager → Message templates (category: Utility),
# wait for approval, then put its name here. Leave blank and the code falls
# back to plain text, which only delivers if WHATSAPP_ALERT_TO has messaged
# your business number within the last 24 hours.
WHATSAPP_TEMPLATE_NAME=
